index 00000000..e4e075e2
--- /dev/null
+++ b/src/libslic3r/PlatePresetOverride.hpp
@@ -0,0 +1,75 @@
+#pragma once
+
+// Per-plate printer / process presets ("multi-printer plates").
+//
+// A project normally slices every plate with the printer and process presets selected in the
+// sidebar. A plate may instead name its own printer preset, and optionally its own process
+// preset, so that one project can hold plates for different machines. The plate is then laid
+// out with that printer's bed and sliced with that printer's settings.
+//
+// The override is applied on top of the project's full config (PresetBundle::full_config()),
+// exactly where the plate's own settings are applied today. Filaments, the project config and
+// the plate settings stay shared with the rest of the project. Because the per-filament and
+// per-extruder vectors in the full config are sized for the project's printer, an override
+// printer must use the same printer technology and the same number of extruders (and, for
+// multi-extruder printers, the same extruder variants) as the project's printer.
+
+#include <string>
+
+namespace Slic3r {
+
+class DynamicPrintConfig;
+class Preset;
+class PresetBundle;
+
+struct PlatePresetOverride
+{
+    // Name of the printer preset the plate uses. Empty means "the project's printer".
+    std::string printer;
+    // Name of the process preset the plate uses. Empty means "the project's process".
+    // A process override without a printer override is allowed.
+    std::string process;
+
+    bool empty() const { return printer.empty() && process.empty(); }
+    bool operator==(const PlatePresetOverride &rhs) const { return printer == rhs.printer && process == rhs.process; }
+    bool operator!=(const PlatePresetOverride &rhs) const { return !(*this == rhs); }
+};
+
+enum class PlatePresetOverrideStatus
+{
+    None,                   // the plate has no override
+    Ok,                     // the override resolves and can be applied
+    PrinterNotFound,        // no printer preset with that name
+    ProcessNotFound,        // no process preset with that name
+    TechnologyMismatch,     // the printer is not an FFF printer like the project's printer
+    ExtruderCountMismatch,  // the printer has a different number of extruders
+    ExtruderVariantMismatch // a multi-extruder printer with different extruder variants
+};
+
+// The printer preset a plate override names, or nullptr. The edited copy is returned for the
+// currently selected printer, so unsaved edits are honoured.
+const Preset *find_plate_printer_preset(const PresetBundle &bundle, const std::string &name);
+// The process preset a plate override names, or nullptr.
+const Preset *find_plate_process_preset(const PresetBundle &bundle, const std::string &name);
+
+// Whether `override_` can be applied on top of `project_full_config`, the project's full config.
+PlatePresetOverrideStatus check_plate_preset_override(const PresetBundle       &bundle,
+                                                      const PlatePresetOverride &override_,
+                                                      const DynamicPrintConfig &project_full_config);
+
+// Overlays the override's printer and process settings onto `full_config`, the project's full
+// config, and returns the check result. `full_config` is changed only when the result is Ok.
+// Precedence follows PresetBundle::full_fff_config(): process < filament < printer < project, so
+// project-level keys are never replaced and a process override does not replace filament or
+// printer keys.
+PlatePresetOverrideStatus apply_plate_preset_override(const PresetBundle       &bundle,
+                                                      const PlatePresetOverride &override_,
+                                                      DynamicPrintConfig       &full_config);
+
+// A user-facing message for a failed check, naming the preset. Empty for None and Ok.
+std::string plate_preset_override_error(PlatePresetOverrideStatus status, const PlatePresetOverride &override_);
+
+// True when `printer_model` belongs to the BBL vendor bundle (see PresetBundle::is_bbl_vendor()).
+bool is_bbl_printer_model(const PresetBundle &bundle, const std::string &printer_model);
+
+} // namespace Slic3r
