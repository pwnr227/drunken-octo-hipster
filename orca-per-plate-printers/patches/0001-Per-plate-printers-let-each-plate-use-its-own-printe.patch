+void PartPlateList::refresh_plate_beds(bool move_instances)
+{
+	// The printer presets live in the GUI's preset bundle; the CLI has none and keeps the project's bed.
+	const PresetBundle* bundle = m_plater != nullptr ? wxGetApp().preset_bundle : nullptr;
+	if (bundle == nullptr && has_plate_printer_overrides())
+		BOOST_LOG_TRIVIAL(warning) << __FUNCTION__ << ": plates name their own printer presets, which are applied only in the GUI";
+	BoundingBoxf extents = m_shape.empty() ? BoundingBoxf() : get_extents(m_shape);
+	bool any_override = false;
+	for (PartPlate* plate : m_plate_list) {
+		plate->m_override_bed.reset();
+		if (bundle == nullptr || !plate->has_printer_override())
+			continue;
+		if (const Preset* printer = find_plate_printer_preset(*bundle, plate->preset_override().printer)) {
+			PlateBed bed = PlateBed::from_printer_config(printer->config);
+			if (bed.shape.size() < 3 || bed.width <= 0 || bed.depth <= 0)
+				continue;
+			extents.merge(bed.extents);
+			plate->m_override_bed = std::move(bed);
+			any_override = true;
+		}
+	}
+
+	// Without overrides the grid keeps the project's plate size, exactly as before.
+	const double cell_width = any_override ? extents.size().x() : 0.;
+	const double cell_depth = any_override ? extents.size().y() : 0.;
+	const bool   grid_changed = cell_width != m_cell_width || cell_depth != m_cell_depth;
+	m_cell_width = cell_width;
+	m_cell_depth = cell_depth;
+
+	// Move the plates, with their objects, to their new place and size.
+	for (unsigned int i = 0; i < (unsigned int)m_plate_list.size(); ++i)
+		place_plate(m_plate_list[i], compute_origin(i, m_plate_cols), move_instances, false);
+	if (grid_changed) {
+		Vec3d origin = compute_origin_for_unprintable();
+		unprintable_plate.set_pos_and_size(origin, m_plate_width, m_plate_depth, m_plate_height, move_instances);
+	}
+	for (unsigned int i = 0; i < (unsigned int)m_plate_list.size(); ++i)
+		shape_plate(m_plate_list[i], compute_shape_position(i, m_plate_cols));
+	calc_bounding_boxes();
+
+	if (m_plater != nullptr && grid_changed) {
+		Vec2d bed_position = compute_shape_position(m_current_plate, m_plate_cols);
+		m_plater->set_bed_position(bed_position);
+	}
 }
 
