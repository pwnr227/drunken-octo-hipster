diff --git a/src/libslic3r/PlatePresetOverride.cpp b/src/libslic3r/PlatePresetOverride.cpp
new file mode 100644
index 00000000..72f8e320
--- /dev/null
+++ b/src/libslic3r/PlatePresetOverride.cpp
@@ -0,0 +1,149 @@
+#include "PlatePresetOverride.hpp"
+
+#include <set>
+#include <string>
+#include <vector>
+
+#include "Config.hpp"
+#include "I18N.hpp"
+#include "Preset.hpp"
+#include "PresetBundle.hpp"
+#include "PrintConfig.hpp"
+#include "format.hpp"
+
+namespace Slic3r {
+
+namespace {
+
+const std::set<std::string> &printer_keys()
+{
+    static const std::set<std::string> keys(Preset::printer_options().begin(), Preset::printer_options().end());
+    return keys;
+}
+
+const std::set<std::string> &filament_keys()
+{
+    static const std::set<std::string> keys(Preset::filament_options().begin(), Preset::filament_options().end());
+    return keys;
+}
+
+size_t nozzle_count(const DynamicPrintConfig &config)
+{
+    const auto *nozzles = config.option<ConfigOptionFloats>("nozzle_diameter");
+    return nozzles == nullptr || nozzles->values.empty() ? 1 : nozzles->values.size();
+}
+
+std::vector<std::string> extruder_variants(const DynamicPrintConfig &config)
+{
+    const auto *variants = config.option<ConfigOptionStrings>("printer_extruder_variant");
+    return variants == nullptr ? std::vector<std::string>() : variants->values;
+}
+
+// Copies the keys of `src` listed in `keys` into `dst`, except the ones `skip` rejects.
+template<class Skip> void overlay(DynamicPrintConfig &dst, const DynamicPrintConfig &src, const std::vector<std::string> &keys, Skip skip)
+{
+    for (const std::string &key : keys) {
+        if (skip(key))
+            continue;
+        if (const ConfigOption *opt = src.option(key); opt != nullptr)
+            dst.set_key_value(key, opt->clone());
+    }
+}
+
+} // namespace
+
+const Preset *find_plate_printer_preset(const PresetBundle &bundle, const std::string &name)
+{
+    return name.empty() ? nullptr : bundle.printers.find_preset(name, false);
+}
+
+const Preset *find_plate_process_preset(const PresetBundle &bundle, const std::string &name)
+{
+    return name.empty() ? nullptr : bundle.prints.find_preset(name, false);
+}
+
+PlatePresetOverrideStatus check_plate_preset_override(const PresetBundle       &bundle,
+                                                      const PlatePresetOverride &override_,
+                                                      const DynamicPrintConfig &project_full_config)
+{
+    if (override_.empty())
+        return PlatePresetOverrideStatus::None;
+
+    if (!override_.printer.empty()) {
+        const Preset *printer = find_plate_printer_preset(bundle, override_.printer);
+        if (printer == nullptr)
+            return PlatePresetOverrideStatus::PrinterNotFound;
+        if (printer->printer_technology() != ptFFF)
+            return PlatePresetOverrideStatus::TechnologyMismatch;
+        const size_t extruders = nozzle_count(project_full_config);
+        if (nozzle_count(printer->config) != extruders)
+            return PlatePresetOverrideStatus::ExtruderCountMismatch;
+        if (extruders > 1 && extruder_variants(printer->config) != extruder_variants(project_full_config))
+            return PlatePresetOverrideStatus::ExtruderVariantMismatch;
+    }
+    if (!override_.process.empty() && find_plate_process_preset(bundle, override_.process) == nullptr)
+        return PlatePresetOverrideStatus::ProcessNotFound;
+    return PlatePresetOverrideStatus::Ok;
+}
+
+PlatePresetOverrideStatus apply_plate_preset_override(const PresetBundle       &bundle,
+                                                      const PlatePresetOverride &override_,
+                                                      DynamicPrintConfig       &full_config)
+{
+    const PlatePresetOverrideStatus status = check_plate_preset_override(bundle, override_, full_config);
+    if (status != PlatePresetOverrideStatus::Ok)
+        return status;
+
+    // project_config holds exactly the project-level keys; they keep the project's values.
+    auto is_project_key = [&bundle](const std::string &key) { return bundle.project_config.has(key); };
+
+    if (const Preset *process = find_plate_process_preset(bundle, override_.process); process != nullptr) {
+        overlay(full_config, process->config, Preset::print_options(), [&](const std::string &key) {
+            return is_project_key(key) || printer_keys().count(key) != 0 || filament_keys().count(key) != 0;
+        });
+        full_config.set_key_value("print_settings_id", new ConfigOptionString(process->name));
+    }
+
+    if (const Preset *printer = find_plate_printer_preset(bundle, override_.printer); printer != nullptr) {
+        overlay(full_config, printer->config, Preset::printer_options(), is_project_key);
+        full_config.set_key_value("printer_settings_id", new ConfigOptionString(printer->name));
+    }
+    return status;
+}
+
+std::string plate_preset_override_error(PlatePresetOverrideStatus status, const PlatePresetOverride &override_)
+{
+    switch (status) {
+    case PlatePresetOverrideStatus::PrinterNotFound:
+        // TRN %1% is the name of a printer preset assigned to a plate.
+        return format(_u8L("The printer preset \"%1%\" assigned to this plate was not found. Choose another printer in the plate settings."), override_.printer);
+    case PlatePresetOverrideStatus::ProcessNotFound:
+        // TRN %1% is the name of a process preset assigned to a plate.
+        return format(_u8L("The process preset \"%1%\" assigned to this plate was not found. Choose another process in the plate settings."), override_.process);
+    case PlatePresetOverrideStatus::TechnologyMismatch:
+        // TRN %1% is the name of a printer preset assigned to a plate.
+        return format(_u8L("The printer \"%1%\" assigned to this plate is not an FFF printer."), override_.printer);
+    case PlatePresetOverrideStatus::ExtruderCountMismatch:
+        // TRN %1% is the name of a printer preset assigned to a plate.
+        return format(_u8L("The printer \"%1%\" assigned to this plate has a different number of extruders than the project's printer."), override_.printer);
+    case PlatePresetOverrideStatus::ExtruderVariantMismatch:
+        // TRN %1% is the name of a printer preset assigned to a plate.
+        return format(_u8L("The printer \"%1%\" assigned to this plate has different extruder types than the project's printer."), override_.printer);
+    case PlatePresetOverrideStatus::None:
+    case PlatePresetOverrideStatus::Ok: break;
+    }
+    return {};
+}
+
+bool is_bbl_printer_model(const PresetBundle &bundle, const std::string &printer_model)
+{
+    if (printer_model.empty())
+        return false;
+    for (const auto &[vendor_name, vendor_profile] : bundle.vendors)
+        for (const auto &model : vendor_profile.models)
+            if (model.name == printer_model)
+                return vendor_name == "BBL";
+    return false;
+}
+
+} // namespace Slic3r
diff --git a/src/libslic3r/PlatePresetOverride.hpp b/src/libslic3r/PlatePresetOverride.hpp
