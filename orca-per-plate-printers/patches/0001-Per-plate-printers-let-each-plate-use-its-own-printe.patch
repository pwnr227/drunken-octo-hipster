+PlateBed PlateBed::from_printer_config(const DynamicPrintConfig& printer_config)
+{
+    PlateBed bed;
+    if (const auto* area = printer_config.option<ConfigOptionPoints>("printable_area"))
+        bed.shape = make_counter_clockwise(area->values);
+    if (const auto* exclude = printer_config.option<ConfigOptionPoints>("bed_exclude_area"))
+        bed.exclude_areas = exclude->values;
+    if (const auto* areas = printer_config.option<ConfigOptionPointsGroups>("extruder_printable_area"))
+        bed.extruder_areas = areas->values;
+    if (const auto* heights = printer_config.option<ConfigOptionFloatsNullable>("extruder_printable_height"))
+        bed.extruder_heights = heights->values;
+    if (const auto* height = printer_config.option<ConfigOptionFloat>("printable_height"))
+        bed.printable_height = height->value;
+    if (const auto* lid = printer_config.option<ConfigOptionFloat>("extruder_clearance_height_to_lid"))
+        bed.height_to_lid = float(lid->value);
+    if (const auto* rod = printer_config.option<ConfigOptionFloat>("extruder_clearance_height_to_rod"))
+        bed.height_to_rod = float(rod->value);
+    if (!bed.shape.empty())
+        bed.extents = get_extents(bed.shape);
+    bed.width = int(bed.extents.size().x());
+    bed.depth = int(bed.extents.size().y());
+    return bed;
+}
