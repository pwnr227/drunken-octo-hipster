+#include <catch2/catch_test_macros.hpp>
+
+#include <string>
+
+#include "libslic3r/Config.hpp"
+#include "libslic3r/PlatePresetOverride.hpp"
+#include "libslic3r/Point.hpp"
+#include "libslic3r/Preset.hpp"
+#include "libslic3r/PresetBundle.hpp"
+#include "libslic3r/PrintConfig.hpp"
+
+#include "test_helpers.hpp"
+
+using namespace Slic3r;
+using namespace Slic3r::Test;
+
+// The per-plate printer reaches the G-code: a plate sliced with the config the plate's printer
+// overrides gets that printer's start G-code, and its bed, not the project's.
+TEST_CASE("A plate with its own printer is sliced with that printer's G-code", "[PlatePresetOverride]")
+{
+    PresetBundle bundle;
+    DynamicPrintConfig &project_printer = bundle.printers.get_edited_preset().config;
+    project_printer.set_key_value("machine_start_gcode", new ConfigOptionString("; PROJECT_PRINTER_START"));
+
+    DynamicPrintConfig other = bundle.printers.default_preset().config;
+    other.set_key_value("machine_start_gcode", new ConfigOptionString("; OTHER_PRINTER_START"));
+    other.set_key_value("printable_area", new ConfigOptionPoints({ { 0., 0. }, { 120., 0. }, { 120., 120. }, { 0., 120. } }));
+    bundle.printers.load_preset(std::string(), "Other Printer", other, false);
+
+    const DynamicPrintConfig project = bundle.full_config();
+    DynamicPrintConfig       plate   = project;
+    REQUIRE(apply_plate_preset_override(bundle, { "Other Printer", {} }, plate) == PlatePresetOverrideStatus::Ok);
+
+    const std::string project_gcode = slice({ cube(20) }, project);
+    const std::string plate_gcode   = slice({ cube(20) }, plate);
+
+    CHECK(project_gcode.find("; PROJECT_PRINTER_START") != std::string::npos);
+    CHECK(plate_gcode.find("; OTHER_PRINTER_START") != std::string::npos);
+    CHECK(plate_gcode.find("; PROJECT_PRINTER_START") == std::string::npos);
+}
