+TEST_CASE("A printer model outside the BBL bundle is not a BBL printer", "[PlatePresetOverride]")
+{
+    PresetBundle bundle;
+    CHECK_FALSE(is_bbl_printer_model(bundle, ""));
+    CHECK_FALSE(is_bbl_printer_model(bundle, "Acme One"));
+}
