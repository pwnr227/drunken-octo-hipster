+#include "libslic3r/Preset.hpp"
+#include "libslic3r/PresetBundle.hpp"
+#include "libslic3r/PrintConfig.hpp"
+
+using namespace Slic3r;
+
+namespace {
+
+const Pointfs project_bed { { 0., 0. }, { 256., 0. }, { 256., 256. }, { 0., 256. } };
+const Pointfs other_bed   { { 0., 0. }, { 180., 0. }, { 180., 180. }, { 0., 180. } };
+
+// A bundle whose selected printer has `project_bed`, plus an unselected "Other Printer" with
+// `other_bed`, a printer with two extruders and a process preset with a 0.12 mm layer height.
+struct Fixture
+{
+    PresetBundle bundle;
+
+    Fixture()
+    {
+        DynamicPrintConfig &project_printer = bundle.printers.get_edited_preset().config;
+        project_printer.set_key_value("printable_area", new ConfigOptionPoints(project_bed));
+        project_printer.set_key_value("printable_height", new ConfigOptionFloat(250.));
+        project_printer.set_key_value("machine_start_gcode", new ConfigOptionString("; project start"));
+
+        DynamicPrintConfig other = bundle.printers.default_preset().config;
+        other.set_key_value("printable_area", new ConfigOptionPoints(other_bed));
+        other.set_key_value("printable_height", new ConfigOptionFloat(180.));
+        other.set_key_value("machine_start_gcode", new ConfigOptionString("; other start"));
+        bundle.printers.load_preset(std::string(), "Other Printer", other, false);
+
+        DynamicPrintConfig dual = bundle.printers.default_preset().config;
+        dual.set_key_value("nozzle_diameter", new ConfigOptionFloats({ 0.4, 0.4 }));
+        bundle.printers.load_preset(std::string(), "Dual Printer", dual, false);
+
+        DynamicPrintConfig fine = bundle.prints.default_preset().config;
+        fine.set_key_value("layer_height", new ConfigOptionFloat(0.12));
+        bundle.prints.load_preset(std::string(), "Fine Process", fine, false);
+
+        bundle.prints.get_edited_preset().config.set_key_value("layer_height", new ConfigOptionFloat(0.2));
+        bundle.filaments.get_edited_preset().config.set_key_value("filament_type", new ConfigOptionStrings({ "PETG" }));
+    }
+};
+
+} // namespace
+
+TEST_CASE("A plate printer replaces the printer settings and keeps the others", "[PlatePresetOverride]")
+{
+    Fixture            f;
+    DynamicPrintConfig config = f.bundle.full_config();
+    const std::vector<std::string> colours = config.option<ConfigOptionStrings>("filament_colour")->values;
+
+    const PlatePresetOverride override_ { "Other Printer", {} };
+    REQUIRE(apply_plate_preset_override(f.bundle, override_, config) == PlatePresetOverrideStatus::Ok);
+
+    CHECK(config.option<ConfigOptionPoints>("printable_area")->values == other_bed);
+    CHECK(config.opt_float("printable_height") == 180.);
+    CHECK(config.opt_string("machine_start_gcode") == "; other start");
+    CHECK(config.opt_string("printer_settings_id") == "Other Printer");
+    // The process, the filaments and the project settings stay the project's.
+    CHECK(config.opt_float("layer_height") == 0.2);
+    CHECK(config.option<ConfigOptionStrings>("filament_type")->values == std::vector<std::string>{ "PETG" });
+    CHECK(config.option<ConfigOptionStrings>("filament_colour")->values == colours);
+}
+
+TEST_CASE("A plate process replaces the process settings only", "[PlatePresetOverride]")
+{
+    Fixture            f;
+    DynamicPrintConfig config = f.bundle.full_config();
+
+    const PlatePresetOverride override_ { {}, "Fine Process" };
+    REQUIRE(apply_plate_preset_override(f.bundle, override_, config) == PlatePresetOverrideStatus::Ok);
+
+    CHECK(config.opt_float("layer_height") == 0.12);
+    CHECK(config.opt_string("print_settings_id") == "Fine Process");
+    CHECK(config.option<ConfigOptionPoints>("printable_area")->values == project_bed);
+    CHECK(config.opt_string("machine_start_gcode") == "; project start");
+}
+
+TEST_CASE("A plate without presets of its own leaves the project config alone", "[PlatePresetOverride]")
+{
+    Fixture                  f;
+    const DynamicPrintConfig project = f.bundle.full_config();
+    DynamicPrintConfig       config  = project;
+
+    CHECK(apply_plate_preset_override(f.bundle, PlatePresetOverride {}, config) == PlatePresetOverrideStatus::None);
+    CHECK(config == project);
+    CHECK(plate_preset_override_error(PlatePresetOverrideStatus::None, PlatePresetOverride {}).empty());
+}
+
+TEST_CASE("A plate preset that cannot be applied leaves the project config alone and is reported", "[PlatePresetOverride]")
+{
+    Fixture                  f;
+    const DynamicPrintConfig project = f.bundle.full_config();
+
+    struct Case
+    {
+        PlatePresetOverride       override_;
+        PlatePresetOverrideStatus status;
+        std::string               named;
+    };
+    const std::vector<Case> cases {
+        { { "Missing Printer", {} }, PlatePresetOverrideStatus::PrinterNotFound, "Missing Printer" },
+        { { {}, "Missing Process" }, PlatePresetOverrideStatus::ProcessNotFound, "Missing Process" },
+        { { "Dual Printer", {} }, PlatePresetOverrideStatus::ExtruderCountMismatch, "Dual Printer" },
+        // A missing process is reported even when the printer resolves.
+        { { "Other Printer", "Missing Process" }, PlatePresetOverrideStatus::ProcessNotFound, "Missing Process" },
+    };
+    for (const Case &c : cases) {
+        DYNAMIC_SECTION(c.named)
+        {
+            DynamicPrintConfig config = project;
+            CHECK(apply_plate_preset_override(f.bundle, c.override_, config) == c.status);
+            CHECK(config == project);
+            CHECK(plate_preset_override_error(c.status, c.override_).find(c.named) != std::string::npos);
+        }
+    }
+}
