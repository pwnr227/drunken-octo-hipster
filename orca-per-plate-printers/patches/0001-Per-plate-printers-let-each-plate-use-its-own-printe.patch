+TEST_CASE("Per-plate printer and process presets survive a 3MF round-trip", "[3mf][PlatePresetOverride]")
+{
+    ScopedSlic3rTemporaryDir temporary_dir("orca_plate_presets");
+
+    Model model;
+    ModelObject *object = model.add_object();
+    object->add_volume(make_cube(10.0, 10.0, 10.0));
+    object->add_instance();
+    model.set_backup_path((temporary_dir.path() / "source_backup").string());
+
+    // The names carry XML special characters, which the writer must escape.
+    const std::string printer = "Acme \"Mini\" & <Co> 0.4 nozzle";
+    const std::string process = "0.20mm Standard @Acme";
+
+    // Plate 1 keeps the project's presets, plate 2 names its own printer and process, plate 3 only a process.
+    std::vector<std::unique_ptr<PlateData>> plates;
+    for (int i = 0; i < 3; ++i) {
+        plates.push_back(std::make_unique<PlateData>());
+        plates.back()->plate_index = i;
+    }
+    plates[1]->printer_preset_override = printer;
+    plates[1]->process_preset_override = process;
+    plates[2]->process_preset_override = process;
+
+    DynamicPrintConfig config;
+    const std::string  path = (temporary_dir.path() / "plate_presets.3mf").string();
+    StoreParams        store_params;
+    store_params.path   = path.c_str();
+    store_params.model  = &model;
+    store_params.config = &config;
+    for (const auto &plate : plates)
+        store_params.plate_data_list.push_back(plate.get());
+    store_params.strategy = SaveStrategy::Zip64 | SaveStrategy::Silence;
+    REQUIRE(store_bbs_3mf(store_params));
+
+    Model                     reloaded_model;
+    DynamicPrintConfig        reloaded_config;
+    ConfigSubstitutionContext substitutions{ForwardCompatibilitySubstitutionRule::Disable};
+    PlateDataPtrs             reloaded;
+    std::vector<Preset *>     project_presets;
+    bool                      is_bbl_3mf  = false;
+    bool                      is_orca_3mf = false;
+    Semver                    file_version;
+    const bool loaded = load_bbs_3mf(path.c_str(), &reloaded_config, &substitutions, &reloaded_model, &reloaded,
+                                     &project_presets, &is_bbl_3mf, &is_orca_3mf, &file_version, nullptr,
+                                     LoadStrategy::LoadModel | LoadStrategy::LoadConfig);
+    std::vector<std::pair<std::string, std::string>> overrides;
+    for (const PlateData *plate : reloaded)
+        overrides.emplace_back(plate->printer_preset_override, plate->process_preset_override);
+    release_PlateData_list(reloaded);
+    for (Preset *preset : project_presets)
+        delete preset;
+
+    REQUIRE(loaded);
+    REQUIRE(overrides.size() == 3);
+    CHECK(overrides[0] == std::make_pair(std::string(), std::string()));
+    CHECK(overrides[1] == std::make_pair(printer, process));
+    CHECK(overrides[2] == std::make_pair(std::string(), process));
+}
