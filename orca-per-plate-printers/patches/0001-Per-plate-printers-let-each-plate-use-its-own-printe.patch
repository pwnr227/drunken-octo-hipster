+std::string PlateSettingsDialog::selected_name(const ComboBox* choice, const std::vector<std::string>& names) const
+{
+    const int selection = choice != nullptr ? choice->GetSelection() : 0;
+    return selection > 0 && selection < int(names.size()) ? names[selection] : std::string();
+}
+
+void PlateSettingsDialog::update_process_choices(const std::string& selected, bool keep_unlisted)
+{
+    const PresetBundle& bundle       = *wxGetApp().preset_bundle;
+    const std::string   printer_name = selected_name(m_printer_choice, m_printer_names);
+    const Preset*       printer      = printer_name.empty() ? &bundle.printers.get_edited_preset() : find_plate_printer_preset(bundle, printer_name);
+
+    m_process_choice->Clear();
+    m_process_names.clear();
+    m_process_choice->Append(_L("Same as project process"));
+    m_process_names.emplace_back();
+    int selection = 0;
+    if (printer != nullptr) {
+        const PresetWithVendorProfile printer_with_vendor = bundle.printers.get_preset_with_vendor_profile(*printer);
+        for (const Preset& process : bundle.prints) {
+            if (!process.is_visible || !is_compatible_with_printer(bundle.prints.get_preset_with_vendor_profile(process), printer_with_vendor))
+                continue;
+            if (process.name == selected)
+                selection = int(m_process_names.size());
+            m_process_choice->Append(from_u8(process.name));
+            m_process_names.push_back(process.name);
+        }
+    }
+    if (selection == 0 && keep_unlisted && !selected.empty()) {
+        selection = int(m_process_names.size());
+        m_process_choice->Append(from_u8(selected));
+        m_process_names.push_back(selected);
+    }
+    m_process_choice->SetSelection(selection);
+}
+
+void PlateSettingsDialog::sync_preset_override(const PlatePresetOverride& preset_override)
+{
+    if (m_printer_choice == nullptr)
+        return;
+    int printer_selection = 0;
+    auto it = std::find(m_printer_names.begin(), m_printer_names.end(), preset_override.printer);
+    if (it != m_printer_names.end())
+        printer_selection = int(it - m_printer_names.begin());
+    else if (!preset_override.printer.empty()) {
+        // A printer the plate names but which is not offered (missing, or another extruder count)
+        // stays selected, so opening the dialog does not drop the plate's setting.
+        printer_selection = int(m_printer_names.size());
+        m_printer_choice->Append(from_u8(preset_override.printer));
+        m_printer_names.push_back(preset_override.printer);
+    }
+    m_printer_choice->SetSelection(printer_selection);
+    update_process_choices(preset_override.process, true);
+}
+
+PlatePresetOverride PlateSettingsDialog::get_preset_override() const
+{
+    return { selected_name(m_printer_choice, m_printer_names), selected_name(m_process_choice, m_process_names) };
+}
