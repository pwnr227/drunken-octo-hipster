+void PartPlateList::place_plate(PartPlate* plate, Vec3d origin, bool with_instance_move, bool do_clear)
+{
+	if (const std::optional<PlateBed>& bed = plate->override_bed())
+		plate->set_pos_and_size(origin, bed->width, bed->depth, bed->printable_height, with_instance_move, do_clear);
+	else
+		plate->set_pos_and_size(origin, m_plate_width, m_plate_depth, m_plate_height, with_instance_move, do_clear);
+}
+
+void PartPlateList::shape_plate(PartPlate* plate, const Vec2d& position)
+{
+	if (const std::optional<PlateBed>& bed = plate->override_bed())
+		plate->set_shape(bed->shape, bed->exclude_areas, bed->extruder_areas, bed->extruder_heights, position, bed->height_to_lid, bed->height_to_rod);
+	else
+		plate->set_shape(m_shape, m_exclude_areas, m_extruder_areas, m_extruder_heights, position, m_height_to_lid, m_height_to_rod);
+}
